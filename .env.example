# ==================================================================
#  إعدادات البيئة — انسخ الملف:  cp .env.example .env  وغيّر القيم
#  ملف .env لا يُرفع على Git ولا يدخل الصورة (موجود في .gitignore و .dockerignore)
# ==================================================================

# بيانات قاعدة البيانات (استخدم حروف وأرقام و - فقط في كلمة المرور)
POSTGRES_USER=helpdesk
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=helpdesk

# اسم البيئة اللي بيظهر في السجلات
APP_ENV=demo

# رقم الإصدار (الافتراضي 1.0.0) — في العرض بنغيّره من سطر الأوامر:
#   APP_VERSION=2.0.0 docker compose up -d --build app
# APP_VERSION=1.0.0
