# syntax=docker/dockerfile:1
# ==================================================================
#  قالب Python (Flask / FastAPI / Django) — نفس قواعد القالب الموحّد
#  لا تغيّر إلا الأسطر المعلَّمة بـ [CHANGE]
# ==================================================================

# [CHANGE] إصدار Python
ARG PYTHON_VERSION=3.12

# ---------- المرحلة 1: تثبيت الاعتماديات في بيئة معزولة ----------
FROM python:${PYTHON_VERSION}-slim AS deps
ENV PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1
WORKDIR /app
COPY requirements.txt .
RUN python -m venv /opt/venv && /opt/venv/bin/pip install -r requirements.txt

# ---------- المرحلة 2: صورة التشغيل ----------
FROM python:${PYTHON_VERSION}-slim AS runtime
ARG APP_VERSION=1.0.0
LABEL org.opencontainers.image.version="${APP_VERSION}"
ENV PATH="/opt/venv/bin:$PATH" \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    APP_VERSION="${APP_VERSION}" \
    PORT=8080

RUN useradd --uid 1000 --create-home appuser
WORKDIR /app
COPY --from=deps /opt/venv /opt/venv
# [CHANGE] مجلد/ملفات الكود
COPY --chown=appuser:appuser . .
USER appuser

EXPOSE 8080
# [CHANGE] مسار فحص الصحة في تطبيقك
HEALTHCHECK --interval=15s --timeout=3s --start-period=15s --retries=3 \
  CMD ["python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8080/health', timeout=2)"]

# [CHANGE] أمر التشغيل — مثال Flask عبر gunicorn (أضِفه في requirements.txt)
# FastAPI:  CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8080"]
CMD ["gunicorn", "--bind", "0.0.0.0:8080", "--workers", "2", "app:app"]
