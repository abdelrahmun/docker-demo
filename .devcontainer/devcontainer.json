{
  "name": "Docker Demo — IT Help Desk",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": { "label": "Help Desk App", "onAutoForward": "openBrowser" }
  },
  "postCreateCommand": "chmod +x demo/run-demo.sh"
}
